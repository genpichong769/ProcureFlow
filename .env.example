DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=procureflow
DB_PASSWORD=your_password_here
DB_NAME=procureflow
DB_POOL_SIZE=8
MYSQL_ROOT_PASSWORD=your_root_password_here
# Relative paths are resolved from the repository root. An absolute host path is also supported.
PROCUREFLOW_DATA_ROOT=./.procureflow-data

QWEN_MODEL=qwen-plus-latest
A2A_BUDGET_PORT=5005
A2A_SUPPLIER_PORT=5006
A2A_COMPLIANCE_PORT=5007
A2A_PROCUREMENT_PORT=5008
MCP_BUDGET_PORT=8001
MCP_SUPPLIER_PORT=8002
MCP_COMPLIANCE_PORT=8003
MCP_PROCUREMENT_PORT=8004
AGENT_TIMEOUT_SECONDS=180
MCP_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=1
SCORE_PRICE_WEIGHT=0.35
SCORE_DELIVERY_WEIGHT=0.25
SCORE_ON_TIME_WEIGHT=0.25
SCORE_QUALITY_WEIGHT=0.15
WORKFLOW_API_PORT=8010
WORKFLOW_MAX_RETRIES=2
